{
    "name": "godar/esky-client",
    "description": "Read-only web browser for the esky memory server",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "league/commonmark": "^2.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Esky\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Esky\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
